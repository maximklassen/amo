# In .env kopieren und eigene Werte eintragen: cp .env.example .env
# Die Datei .env wird nicht in Git eingecheckt, .env.example schon.

APP_NAME="ParzellenPlaner"
APP_ENV=local          # local | production
APP_DEBUG=true         # in Produktion unbedingt false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Europe/Berlin

# Geheimer Schlüssel zum Signieren von Tokens/Sessions. Erzeugen mit: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Datenbank (PDO) ---
# Treiber: mysql (Entwicklung/Produktion) oder sqlite (z. B. für schnelle Tests)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kleingarten
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Bei sqlite ist DB_DATABASE ein Dateipfad (relativ zu backend/) oder :memory:

# --- Anmeldung und Sessions ---
# bcrypt-Aufwand für Passwort-Hashes (4 nur für Tests, im Betrieb 12)
AUTH_BCRYPT_COST=12
SESSION_NAME=PARZELLEN_SID
# Automatisch abmelden nach so vielen Minuten ohne Aktivität
SESSION_IDLE_MINUTES=120
# Leer lassen = automatisch (Secure-Cookie bei HTTPS). true/false erzwingt den Wert.
SESSION_SECURE=

# --- Logs ---
# Pfad relativ zu backend/ oder absolut; LOG_LEVEL: debug | info | warning | error
LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug
